# laeuft - siehe app/data_dir.py)
PhotosHelper/
CameraHelper/
CalendarHelper/

# Editor / tooling caches
.cache/
.vscode/

# Swift / Xcode
JarvisApp/.build/
JarvisApp/.swiftpm/
JarvisMobile/build/
**/DerivedData/

# Zur Laufzeit aus app/*.swift kompilierte Helfer-Binaries (photos_client.py/
# stt_engines.py bauen sie bei Bedarf automatisch neu) - Build-Ergebnisse,
# keine Quelltexte.
app/apple_speech
app/photos_helper
*.xcuserstate
**/xcuserdata/

# Voice recordings / audio test fixtures (biometric, never belongs in git)
*.wav
*.mp3

# Old manual backup dumps and large export archives
/ Jarvis App 1/
*.zip

# Bundled Ollama runtime + model weights (multi-GB binaries, not fit for git -
# assembled locally before an export/build). Licenses/ stays tracked (small
# text files).
JarvisApp/Sources/JarvisApp/Resources/ollama-runtime/
JarvisApp/Sources/JarvisApp/Resources/bundled-models/

# sherpa-onnx/onnxruntime xcframeworks for JarvisMobile's on-device Piper TTS
# (~194 MB combined) - compiled build artifacts, not source. Only ever built
# and deployed from this MacBook (JarvisMobile is never built on the Mac
# Mini), so there is no need to sync them via git. Rebuild with:
#   git clone --depth 1 https://github.com/k2-fsa/sherpa-onnx.git /tmp/sherpa-onnx-build
#   cd /tmp/sherpa-onnx-build && brew install cmake wget && ./build-ios.sh
# then copy build-ios/sherpa-onnx.xcframework and
# build-ios/ios-onnxruntime/<version>/onnxruntime.xcframework into
# JarvisMobile/JarvisMobile/.
JarvisMobile/JarvisMobile/sherpa-onnx.xcframework/
JarvisMobile/JarvisMobile/onnxruntime.xcframework/

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent fuer den headless Jarvis-Mac-Mini-Worker.
  Siehe plans/... "Jarvis Mac-Mini-Worker" und scripts/remote_worker_launch.sh.

  Installation auf dem Mac Mini (einmalig):
    cp scripts/com.leon.jarvis.remoteworker.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.leon.jarvis.remoteworker.plist

  Neu starten nach einer Code-Aenderung:
    launchctl unload ~/Library/LaunchAgents/com.leon.jarvis.remoteworker.plist
    launchctl load ~/Library/LaunchAgents/com.leon.jarvis.remoteworker.plist

  WICHTIG: der <string>-Pfad unter ProgramArguments unten muss auf den
  tatsaechlichen Speicherort des geklonten Repos auf DIESEM Mac Mini zeigen -
  beim Kopieren dieser Datei den Platzhalter ersetzen.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.leon.jarvis.remoteworker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>REPO_ROOT_PLACEHOLDER/scripts/remote_worker_launch.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/jarvis_remote_worker_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/jarvis_remote_worker_launchd.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

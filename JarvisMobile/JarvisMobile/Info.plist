<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Jarvis Mobile</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Gleicher Grund wie bei JarvisApp (macOS): Tailscale nutzt den
             CGNAT-Bereich 100.64.0.0/10 (RFC 6598), den Apples
             NSAllowsLocalNetworking-Heuristik nicht abdeckt - live
             verifiziert 2026-09-05. Diese App spricht nur mit einem
             einzigen, selbst konfigurierten Fernserver (Mac Mini). -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Jarvis braucht Mikrofonzugriff, um deine gesprochenen Nachrichten zu verstehen.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Jarvis wandelt deine gesprochenen Nachrichten lokal auf dem Gerät in Text um.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Jarvis liest deine Schlaf-, Puls- und Aktivitätswerte, um dich im Chat darauf ansprechen zu können.</string>
    <key>UIBackgroundModes</key>
    <array>
        <!-- Erlaubt einer BEREITS AKTIVEN Audio-Sitzung (Mikrofon-Aufnahme
             oder Sprachausgabe), im Hintergrund weiterzulaufen (z.B. bei
             gesperrtem Bildschirm) - wie ChatGPTs Sprachmodus. Startet KEIN
             neues Zuhoeren aus dem Hintergrund heraus (das bleibt technisch
             ausgeschlossen, siehe VoiceManager.swift-Kommentar zu Voice
             Wake) - nur eine schon laufende Sitzung wird nicht abgewuergt. -->
        <string>audio</string>
    </array>
</dict>
</plist>
